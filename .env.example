DATABASE_URL=
AUTH_SECRET=

# Pre-launch "coming soon" gate (see proxy.ts). Leave LAUNCH_GATE_ENABLED
# unset/false while developing -- the real site stays visible to everyone,
# including locally. Set it to "true" on Vercel when you want the public to
# see the countdown instead of the app.
LAUNCH_GATE_ENABLED=false
LAUNCH_GATE_BYPASS_SECRET=
# ISO date-time the countdown counts down to, e.g. 2026-10-15T09:00:00Z.
# Public (client-side) because the countdown timer runs in the browser.
NEXT_PUBLIC_LAUNCH_AT=
